generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  JOB_SEEKER
  EMPLOYER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(JOB_SEEKER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobApplications      JobApplication[]
  tags                 Tag[]
  employerProfile      EmployerProfile?
  jobSeekerProfile     JobSeekerProfile?
  files                UserFile[]
  applicationMessages  ApplicationMessage[]
  notifications              Notification[] @relation("NotificationRecipient")
  notificationsSent          Notification[] @relation("NotificationActor")
  notificationPreferences    UserNotificationPreferences?
}

model UserNotificationPreferences {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifyNewApplication    Boolean @default(true)
  notifyNewMessage        Boolean @default(true)
  notifyInterviewReminder Boolean @default(true)
  notifyWeeklySummary     Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model EmployerProfile {
  userId    String  @id
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
}

model JobSeekerProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline     String?
  bio          String?
  phone        String?
  location     String?
  linkedinUrl  String?
  portfolioUrl String?
  githubUrl    String?

  currentResumeFileId String?   @unique
  currentResumeFile   UserFile? @relation("CurrentResume", fields: [currentResumeFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserFileKind {
  RESUME
}

model UserFile {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       UserFileKind @default(RESUME)
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  createdAt DateTime @default(now())

  currentResumeForProfile JobSeekerProfile? @relation("CurrentResume")
  jobApplications         JobApplication[]  @relation("ApplicationResume")

  @@index([userId])
  @@index([kind])
}

enum WorkArrangement {
  REMOTE
  HYBRID
  ONSITE
}

enum ExperienceLevel {
  INTERN
  ENTRY
  MID
  SENIOR
  LEAD
}

model Company {
  id        String   @id @default(uuid())
  name      String
  tagline   String?
  website   String?
  linkedin  String?
  locations String?
  about     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts          Contact[]
  jobApplications   JobApplication[]
  jobListings       JobListing[]
  employerProfiles  EmployerProfile[]

  @@unique([name])
}

model JobListing {
  id                String            @id @default(uuid())
  title             String
  summary           String?
  city              String?
  workArrangement   WorkArrangement   @default(ONSITE)
  experienceLevel ExperienceLevel   @default(MID)
  salaryText        String?
  sourceUrl         String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  publishedAt DateTime?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications JobApplication[]

  @@index([companyId])
  @@index([city])
  @@index([workArrangement])
  @@index([experienceLevel])
  @@index([title])
  @@index([isActive, publishedAt])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  title     String?
  email     String?
  phone     String?
  linkedin  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobApplications JobApplicationContact[]

  @@index([companyId])
  @@index([email])
}

enum JobApplicationStatus {
  DRAFT
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  ARCHIVED
}

enum ReminderStatus {
  PENDING
  DONE
  CANCELLED
}

model JobApplication {
  id          String               @id @default(uuid())
  title       String
  status      JobApplicationStatus @default(APPLIED)
  appliedAt   DateTime?
  notes       String?
  coverLetter String?
  location    String?
  salaryText  String?

  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId   String
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)

  jobListingId String?
  jobListing   JobListing?         @relation(fields: [jobListingId], references: [id], onDelete: SetNull)

  resumeFileId String?
  resumeFile   UserFile?           @relation("ApplicationResume", fields: [resumeFileId], references: [id], onDelete: SetNull)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  contacts     JobApplicationContact[]
  interviews   Interview[]
  reminders    Reminder[]
  links        JobApplicationLink[]
  attachments  Attachment[]
  statusEvents JobApplicationStatusEvent[]
  tags         JobApplicationTag[]
  thread       ApplicationThread?
  notifications Notification[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([appliedAt])
  @@index([jobListingId])
  @@index([resumeFileId])
  @@unique([userId, companyId, title])
  @@unique([userId, jobListingId])
}

model ApplicationThread {
  id               String         @id @default(uuid())
  jobApplicationId String         @unique
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  messages ApplicationMessage[]
}

model ApplicationMessage {
  id           String            @id @default(uuid())
  threadId     String
  thread       ApplicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId String
  sender       User              @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime          @default(now())
  notifications Notification[]

  @@index([threadId, createdAt])
  @@index([senderUserId])
}

enum NotificationType {
  MESSAGE
  NEW_APPLICATION
  STATUS_EVENT
}

model Notification {
  id               String           @id @default(uuid())
  type             NotificationType
  title            String
  body             String?
  createdAt        DateTime         @default(now())
  readAt           DateTime?

  recipientUserId  String
  recipient        User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  actorUserId      String?
  actor            User?            @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  jobApplicationId String?
  jobApplication   JobApplication?  @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  messageId        String?
  message          ApplicationMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@index([jobApplicationId])
  @@index([messageId])
}

model JobApplicationContact {
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  contactId        String
  contact          Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  role             String? // e.g. Recruiter, Hiring Manager
  createdAt        DateTime @default(now())

  @@id([jobApplicationId, contactId])
  @@index([contactId])
}

model Interview {
  id              String   @id @default(uuid())
  title           String   // e.g. "Tech interview", "HR screen"
  scheduledAt     DateTime
  durationMinutes Int?
  location        String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId])
  @@index([scheduledAt])
}

model Reminder {
  id          String         @id @default(uuid())
  title       String
  remindAt    DateTime
  status      ReminderStatus @default(PENDING)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId])
  @@index([remindAt])
  @@index([status])
}

model JobApplicationLink {
  id          String   @id @default(uuid())
  label       String?  // e.g. "Job post", "Company page", "Portfolio"
  url         String
  createdAt   DateTime @default(now())

  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId])
  @@index([url])
}

model Attachment {
  id           String   @id @default(uuid())
  filename     String
  mimeType     String?
  sizeBytes    Int?
  storageKey   String? // later: S3 key/path, etc.
  url          String? // later: signed URL or public URL
  notes        String?
  createdAt    DateTime @default(now())

  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId])
}

model JobApplicationStatusEvent {
  id        String               @id @default(uuid())
  from      JobApplicationStatus?
  to        JobApplicationStatus
  at        DateTime             @default(now())
  note      String?

  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId])
  @@index([to])
  @@index([at])
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String? // e.g. hex "#AABBCC"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobApplications JobApplicationTag[]

  @@unique([userId, name])
  @@index([userId])
}

model JobApplicationTag {
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  tagId            String
  tag              Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())

  @@id([jobApplicationId, tagId])
  @@index([tagId])
}

