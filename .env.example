## API
PORT=4000

## Auth (HS256 signing secret; use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

## Optional: Next.js origin for CORS (default: allow all in dev)
# WEB_ORIGIN="http://localhost:3000"

## Web (browser-visible; used by Next.js `web/`)
# NEXT_PUBLIC_API_URL="http://localhost:4000"

## Database (used by Prisma)
DATABASE_URL="postgresql://huntflow:huntflow@localhost:5433/huntflow?schema=public"

