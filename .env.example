## API
PORT=4000

## Auth (HS256 signing secret; use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

## Optional: Next.js origin for CORS (default: allow all in dev)
# WEB_ORIGIN="http://localhost:3000"

## Web (browser-visible; used by Next.js `web/`)
# NEXT_PUBLIC_API_URL="http://localhost:4000"

## Next.js server → API (rewrites + SSR; defaults to localhost:4000)
# API_URL="http://localhost:4000"

## Database (used by Prisma)
DATABASE_URL="postgresql://huntflow:huntflow@localhost:5433/huntflow?schema=public"

## Isolated test database (API Vitest integration tests; run `npm run db:test:setup` once)
# DATABASE_URL_TEST="postgresql://huntflow:huntflow@localhost:5433/huntflow_test?schema=public"

## API file uploads (resumes); default: api/uploads
# UPLOAD_DIR="api/uploads"

## Demo data (after `npm run db:seed`)
# Password for all @demo.huntflow.app accounts: Demo1234!
# Employer: employer@demo.huntflow.app  →  Aurora Analytics postings & applications
# Seeker:  alex.morgan@demo.huntflow.app  (and other *@demo.huntflow.app users)

## Optional: contact form email notifications (Resend)
# SUPPORT_INBOX_EMAIL="hello@huntflow.app"
# RESEND_API_KEY="re_..."
# CONTACT_FROM_EMAIL="huntFlow <onboarding@resend.dev>"
# NOTIFICATION_FROM_EMAIL="huntFlow <onboarding@resend.dev>"

## Required for email/push deep links in production
# WEB_ORIGIN="http://localhost:3000"

## Optional: browser Web Push (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:hello@huntflow.app"

## Background notification jobs (schedule alerts + weekly digest).
## API: set NOTIFICATION_JOBS_ENABLED=false and run `npm run dev:worker` in a separate terminal.
# NOTIFICATION_JOBS_ENABLED=true

