{
  "name": "huntflow",
  "private": true,
  "workspaces": [
    "web",
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace web run dev",
    "dev:api": "npm --workspace api run dev",
    "dev:worker": "npm --workspace api run worker",
    "dev": "npm run dev:api && npm run dev:web",
    "lint:web": "npm --workspace web run lint",
    "lint:api": "npm --workspace api run lint",
    "db:generate": "npm --workspace @huntflow/db run prisma:generate",
    "db:migrate": "npm --workspace @huntflow/db run prisma:migrate",
    "db:deploy": "npm --workspace @huntflow/db run prisma:deploy",
    "db:studio": "npm --workspace @huntflow/db run prisma:studio",
    "db:seed": "npm --workspace @huntflow/db run prisma:seed",
    "db:test:setup": "node scripts/db-test-setup.mjs",
    "build:contracts": "npm run build --workspace @huntflow/contracts",
    "test": "npm run build:contracts && npm run test --workspace api && npm run test --workspace web",
    "test:all": "npm run test && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
